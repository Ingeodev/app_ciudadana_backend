{
  "functions": {
    "source": "src",
    "runtime": "nodejs20",
    "ignore": [
      "node_modules",
      "__tests__",
      "migrations",
      "seeders",
      "infra",
      "uploads",
      "*.test.js",
      "jest.config*.js",
      ".env",
      ".env.*",
      "**/config.json",
      "**/*_key.json",
      "**/secrets.json",
      "**/example.env"
    ]
  },
  "storage": {
    "rules": "storage.rules"
  }
}