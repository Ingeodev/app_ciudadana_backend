# ============================================================
# Cali Mobility Backend — PLANTILLA DE VARIABLES DE ENTORNO
#
# Copiar a uno de estos nombres y completar con valores reales:
#   .env.development   → desarrollo local (default)
#   .env.production    → producción local / referencia
#
# En Firebase Cloud Functions ESTE archivo NO se sube (ver firebase.json).
# Las variables se inyectan vía Secret Manager / env vars del host.
# ============================================================

# --- Runtime ---
NODE_ENV=development
PORT=3000

# --- Base de datos (Postgres/Supabase) ---
# Identificación: la URL de conexión NO se define como variable. Se CONSTRUYE
# en src/models/index.js con un template literal a partir de estas variables:
#   `postgres://user:pass@host:port/db` con encodeURIComponent en user/pass.
DB_HOST=HOST
DB_PORT=5432
DB_NAME=NOMBRE_BD
DB_USER=USUARIO
DB_PASSWORD=PASSWORD

# --- Firebase ---
# En Cloud Functions: NO se necesita ninguna de estas variables.
# El Admin SDK se inicializa automáticamente con las credenciales del proyecto.
#
# Para desarrollo local, usar UNA de estas dos opciones (prioridad 1 → 2):
#   1. FIREBASE_SERVICE_ACCOUNT_PATH → ruta al archivo JSON del service account
#   2. FIREBASE_SERVICE_ACCOUNT     → contenido JSON inline del service account
#
# Si ninguna está definida, se intenta el fallback local:
#   src/config/account_service_key.json
FIREBASE_SERVICE_ACCOUNT_PATH=./config/account_service_key.json
FIREBASE_SERVICE_ACCOUNT=

# --- Firebase Storage ---
# Nombre del bucket de Cloud Storage (sin gs://).
# Se usa en upload/download de archivos (imágenes, PDFs, reportes, comprobantes).
# Formato: <project-id>.firebasestorage.app
FIREBASE_STORAGE_BUCKET=

# --- FCM (notificaciones push) ---
FCM_TOPIC_NAME_MOBILE=

# --- SendGrid (email) ---
SENDGRID_API_KEY=
SENDGRID_EMAIL=

# --- Sigma SMS ---
SIGMA_ACCOUNT_KEY=
