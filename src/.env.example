# ============================================================
# PRODUCCIÓN — Cali Mobility Backend
# Cargado por src/config/dotenv.js cuando NODE_ENV=production.
# NO se versiona (gitignored). Referencia para despliegue local/emulador.
# En Firebase Cloud Functions los valores van por Secret Manager.
# ============================================================

NODE_ENV=
PORT=

# --- Base de datos (Postgres) ---
# La URL de conexión se CONSTRUYE en src/models/index.js con un template
# literal a partir de estas variables. El password va CRUDO (sin percent-encode):
# el código aplica encodeURIComponent a DB_USER y DB_PASSWORD.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Firebase ---
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT=

# --- FCM (notificaciones push) ---
FCM_TOPIC_NAME_MOBILE=

# --- File management ---
UPLOADS_DIR=

# --- SendGrid (email) ---
SENDGRID_API_KEY=
SENDGRID_EMAIL=

#--- Email provider ---

EMAIL_PROVIDER=

# Para Gmail
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Sigma SMS ---
SIGMA_ACCOUNT_KEY=

# Firebase Storage bucket name (without gs://)
FIREBASE_STORAGE_BUCKET=
