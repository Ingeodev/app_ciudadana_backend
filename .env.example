# --- Application ---
NODE_ENV=development
PORT=3001
APP_DOMAIN=http://localhost:3001

# --- Database (PostgreSQL) ---
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=calimobility
DB_DIALECT=postgres

# --- Firebase / Notifications ---
FCM_TOPIC_NAME_MOBILE=cali_mobility_alerts
# Paths to JSON keys (can be relative to src or absolute)
FIREBASE_SERVICE_ACCOUNT_PATH=./config/account_service_key.json

# --- External Services ---
SIGMA_ACCOUNT_KEY=your_sigma_sms_token_here

# --- Microservices URLs (Monolith redirection) ---
FRONT_URL=http://localhost:3000
FILE_MANAGEMENT_URL=http://localhost:3001/api/web/v1/file_management
